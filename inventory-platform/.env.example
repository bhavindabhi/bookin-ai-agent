# SQLite file — fine for a single shop. Swap the provider in prisma/schema.prisma
# to "postgresql" and point this at a real database when this becomes multi-shop.
DATABASE_URL="file:./dev.db"

# Long random string used to sign the session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

PORT=3001
