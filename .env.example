# Required to actually send: sends via Microsoft Graph (app-only), not SMTP —
# most Microsoft 365 tenants now block Basic Auth/app passwords for SMTP, so
# this is the reliable path. Set up an Azure AD app registration with the
# Mail.Send *application* permission (admin consent required), then fill in:
EMAIL_USER="you@yourbusiness.com"        # the mailbox the agent sends as
AZURE_TENANT_ID=                          # "Directory (tenant) ID" on the app's Overview page
AZURE_CLIENT_ID=                          # "Application (client) ID" on the app's Overview page
AZURE_CLIENT_SECRET=                      # value from Certificates & secrets (copy it immediately, shown once)

# Delay between each send, in ms — keeps you well under Graph/Exchange sending
# limits and looks less like a spam blast. Don't set this to 0 for real sending.
EMAIL_SEND_DELAY_MS=4000

# Optional: makes outreach emails better-written and personalized per lead.
# Without it, a plain template is used instead (still fully functional).
ANTHROPIC_API_KEY=

# Optional: real lead discovery providers. Without either of these, the
# agent scrapes the web directly (DuckDuckGo + site pages) for leads — no
# paid key required, but noisier/slower than a proper API.
SERPAPI_KEY=
GOOGLE_PLACES_API_KEY=

# Your business identity, used in every outreach email
BUSINESS_NAME="Your Dental Supply Co"
SENDER_NAME="Your Name"
SENDER_EMAIL="you@yourbusiness.com"
BUSINESS_ADDRESS="Street, City, Country (required for CAN-SPAM/GDPR compliance in outreach emails)"
