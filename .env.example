# Supabase project credentials (get from supabase.com > Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Set these as Supabase Edge Function secrets (supabase secrets set KEY=value):
# OPENAI_API_KEY=sk-...          — OpenAI API key with Realtime API access
# TWILIO_ACCOUNT_SID=AC...       — Twilio account SID (for phone calls)
# TWILIO_AUTH_TOKEN=...          — Twilio auth token
