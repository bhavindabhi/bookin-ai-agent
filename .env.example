# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-4-8 is the default (most capable). For a high-volume WhatsApp bot
# where most messages are simple ("reorder my last order", "price of X"),
# claude-sonnet-5 or claude-haiku-4-5 are cheaper options worth benchmarking.
CLAUDE_MODEL=claude-opus-4-8
# Shown to Claude in the system prompt (frozen at startup, not per-request).
BUSINESS_NAME=Your Dental Supply Co

# --- Shopify ---
# Your store's *.myshopify.com domain, no https:// prefix.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Admin API access token from a custom app (Settings > Apps > Develop apps).
# Needs read_products, read_customers, write_draft_orders, read_orders scopes.
SHOPIFY_ADMIN_API_TOKEN=shpat_...
SHOPIFY_API_VERSION=2024-10

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# The WhatsApp-enabled Twilio number, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Set to "false" only for local testing without a public HTTPS URL.
VERIFY_TWILIO_SIGNATURE=true
# Public HTTPS URL Twilio uses to reach this server (needed for signature
# verification). E.g. your ngrok URL + /webhook/whatsapp during local dev.
PUBLIC_WEBHOOK_URL=https://your-domain.example.com/webhook/whatsapp

# --- Server ---
PORT=3000
