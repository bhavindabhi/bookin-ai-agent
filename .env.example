# Required: powers email drafting and the negotiation engine
ANTHROPIC_API_KEY=

# Optional: real lead discovery providers. Without either of these,
# the agent falls back to the "mock" provider (sample leads for testing).
SERPAPI_KEY=
GOOGLE_PLACES_API_KEY=

# Your business identity, used in email templates
BUSINESS_NAME="Your Dental Supply Co"
SENDER_NAME="Your Name"
SENDER_EMAIL="you@yourbusiness.com"
BUSINESS_ADDRESS="Street, City, Country (required for CAN-SPAM/GDPR compliance in outreach emails)"
