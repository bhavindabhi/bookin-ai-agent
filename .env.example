# Required to actually send: your Outlook mailbox, via SMTP app password.
# Outlook.com: create one at https://account.live.com/proofs/AppPassword (needs 2FA enabled first)
# Microsoft 365 / work account: ask your admin to enable SMTP AUTH for the mailbox,
#   or create an app password if your org allows it.
EMAIL_USER="you@outlook.com"
EMAIL_APP_PASSWORD=
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587
# Delay between each send, in ms — keeps you well under Outlook's sending limits
# and looks less like a spam blast. Don't set this to 0 for real sending.
EMAIL_SEND_DELAY_MS=4000

# Optional: makes outreach emails better-written and personalized per lead.
# Without it, a plain template is used instead (still fully functional).
ANTHROPIC_API_KEY=

# Optional: real lead discovery providers. Without either of these, the
# agent scrapes the web directly (DuckDuckGo + site pages) for leads — no
# paid key required, but noisier/slower than a proper API.
SERPAPI_KEY=
GOOGLE_PLACES_API_KEY=

# Your business identity, used in every outreach email
BUSINESS_NAME="Your Dental Supply Co"
SENDER_NAME="Your Name"
SENDER_EMAIL="you@yourbusiness.com"
BUSINESS_ADDRESS="Street, City, Country (required for CAN-SPAM/GDPR compliance in outreach emails)"
